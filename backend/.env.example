NODE_ENV=production
DEMO_MODE=false
PORT=11020
API_URL=https://your-backend.onrender.com/api
FRONT_URL=https://your-frontend.onrender.com

# PostgreSQL Connection String
# On Render: copy the "Internal Database URL" (if both services are on Render)
# or "External Database URL" from your Render PostgreSQL dashboard.
DATABASE_URL=postgresql://user:password@host.render.com/dbname?sslmode=require

SECRET_KEY=your_production_secret_key_here

# Set to true to automatically seed the admin account and demo data on startup
SEED=true

# SMTP Mailer Settings (Optional)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_RECEIVER_EMAIL=admin@example.com
